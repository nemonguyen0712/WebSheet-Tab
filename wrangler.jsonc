// Cloudflare Workers config for the site, built by OpenNext (see open-next.config.ts and DEPLOY.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oliu",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference the OpenNext adapter needs; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "oliu"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "e037e39387f44af3a98b05f527890a4f"
    }
  ],
  // Cloudflare Images: scales the 600 dpi sheet pictures down before the name is stamped (src/lib/stamp.ts).
  "images": {
    "binding": "IMAGES"
  },
  // Daily at 03:00 Vietnam time (20:00 UTC): the maintenance run in worker.ts.
  "triggers": {
    "crons": ["0 20 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // Secrets (Supabase, Google, …) are not here: set them in the dashboard or with `wrangler secret put`.
}
