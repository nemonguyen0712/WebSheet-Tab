# ---------- Google Drive (private folder) ----------
# ID of the Drive folder, from its URL: drive.google.com/drive/folders/<ID> (or the whole URL).
# Several folders (e.g. owned by different people): separate them with commas; their songs are merged.
DRIVE_FOLDER_ID=
# Service account key (the JSON file from Google Cloud), pasted as one line or base64-encoded.
# Share the Drive folder with the service account's email (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Supabase (login + subscriptions) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Payments ----------
# manual (default): VietQR with the amount filled in and the buyer's phone as the transfer note; you confirm each order in /admin
# sepay: same QR, note TAB<order>, activated automatically by SePay. payos: payOS checkout page.
PAYMENT_PROVIDER=manual
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Bank account for PAYMENT_PROVIDER=manual or sepay. Defaults to Techcombank 9908928517 (HUYNH NHAT ANH);
# set these only to use another account. BANK_NAME is the short name, e.g. Techcombank, MBBank
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
# Only for PAYMENT_PROVIDER=sepay
SEPAY_API_KEY=

# ---------- Site ----------
# Optional: your public URL, e.g. https://oliu.onrender.com (otherwise taken from the request)
NEXT_PUBLIC_SITE_URL=
# Comma-separated phone numbers that can open /admin, e.g. 0901234567
ADMIN_PHONES=
# Devices one account can be signed in on at once
MAX_DEVICES=1
NEXT_PUBLIC_SITE_NAME=Oliu
# Zalo number for customer support (forgotten passwords, payments). Defaults to 0908928517; set it only to use another number.
NEXT_PUBLIC_ZALO=

# Local development only: fake a visitor without Supabase (none | free | paid | admin)
# DEV_VIEWER=paid
