# ---------- Google Drive (private folder) ----------
# ID of the Drive folder, from its URL: drive.google.com/drive/folders/<ID>
DRIVE_FOLDER_ID=
# Service account key (the JSON file from Google Cloud), pasted as one line or base64-encoded.
# Share the Drive folder with the service account's email (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Supabase (login + subscriptions) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Payments ----------
# payos (default) or sepay
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Only for PAYMENT_PROVIDER=sepay
SEPAY_API_KEY=
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# ---------- Site ----------
# Your public URL, e.g. https://khotab.netlify.app (used for login and payment redirects)
NEXT_PUBLIC_SITE_URL=
# Comma-separated phone numbers that can open /admin, e.g. 0901234567
ADMIN_PHONES=
# Devices one account can be signed in on at once
MAX_DEVICES=1
NEXT_PUBLIC_SITE_NAME=Oliutab
# Your Zalo number for customer support (forgotten passwords…), e.g. 0901234567
NEXT_PUBLIC_ZALO=

# Local development only: fake a visitor without Supabase (none | free | paid | admin)
# DEV_VIEWER=paid
